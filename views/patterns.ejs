<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>OpenBible pattern lab</title>
</head>

<body>
	<header>
		<a href="/">OpenBible</a>
		<nav>
			<a href="/1/1">bible</a>
			<a href="/stats">stats</a>
			<a href="/patterns" aria-current="page">patterns</a>
		</nav>
	</header>

	<main>
		<section>
			<h1>pattern lab</h1>
			<p>unstyled surfaces and controls for rebuilding the system from scratch.</p>
		</section>

		<section>
			<h2>buttons</h2>
			<p>
				<a href="#">default link</a>
				<button type="button">button</button>
				<button type="button" disabled>disabled button</button>
			</p>
		</section>

		<section>
			<h2>navigation shells</h2>
			<nav>
				<a href="#">prev</a>
				<a href="#">next</a>
			</nav>
		</section>

		<section>
			<h2>form controls</h2>
			<label>
				book
				<select name="book">
					<option>Genesis</option>
					<option>Exodus</option>
				</select>
			</label>
			<label>
				chapter
				<select name="chapter">
					<option>1</option>
					<option>2</option>
				</select>
			</label>
			<label>
				<input type="checkbox">
				checked
			</label>
		</section>

		<section>
			<h2>pills and cards</h2>
			<div>
				<button type="button">pill action</button>
				<button type="button">another action</button>
			</div>
			<article>
				<h3>card title</h3>
				<p>card body text</p>
			</article>
		</section>

		<section>
			<h2>reader content</h2>
			<p><sup>1</sup> verse text goes here with <span>edited bits</span> and <span>plain bits</span>.</p>
			<p><sup>2</sup> another verse line.</p>
		</section>

		<section>
			<h2>tooltips and panels</h2>
			<details>
				<summary>appearance panel</summary>
				<div>
					<p>font</p>
					<p>size</p>
				</div>
			</details>
			<details>
				<summary>stats panel</summary>
				<div>
					<p>progress: 42%</p>
				</div>
			</details>
		</section>
	</main>
</body>

</html>