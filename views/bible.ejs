 main bible view -->
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>The Bible - <%= bookName %> <%= chapterID %>
	</title>
	<link rel="stylesheet" href="/style.css">
	<link rel="stylesheet" href="/bible.css">
	<% if (turnstileSiteKey) { %>
		<link rel="preconnect" href="https://challenges.cloudflare.com">
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
	<% } %>
	<script src="/bible.js"></script>
</head>

<body data-book-id="<%= bookID %>" data-chapter-id="<%= chapterID %>" data-appearance-font="<%= appearanceFont %>" data-appearance-size="<%= appearanceSize %>" data-turnstile-sitekey="<%= turnstileSiteKey %>">
	<header>
		<%- include('header', { currentPath }) %>
		<nav id="reader-nav">
			<div id="dropdowns">

				<select name="book" id="book-select" class="cursor-hover-effect surface-pill">
					<% allBooks.forEach(book=> { %>
						<option value="<%= book.id %>" <% if (book.id===bookID) { %>selected<% } %>>
							<%= book.name %>
						</option>
					<% }) %>
				</select>
				<select name="chapter" id="chapter-select" class="cursor-hover-effect surface-pill">
					<% for( let i=1; i <=numChapters; i++ ) { %>
						<option value="<%= i %>" <% if (i===chapterID) { %>selected<% } %>>
							<%= i %>
						</option>
					<% } %>
				</select>
			</div>
			<a id="appearance-btn" class="cursor-hover-effect surface-pill surface-center surface-shadow-soft">
				Aa
				
			</a>
			<section id="appearance-panel" class="surface-card" hidden>
					<p>font:</p>
					<optgroup id="appr-grp-font">
						<option value="sans" id="appr-font-sans" aria-selected="false">Aa</option>
						<option value="serif" id="appr-font-serif" aria-selected="true">Aa</option>
					</optgroup>
					<p>size:</p>
					<optgroup id="appr-grp-sz">
						<option value="sm" id="appr-sz-sm" aria-selected="false">small</option>
						<option value="md" id="appr-sz-md" aria-selected="true">medium</option>
						<option value="lg" id="appr-sz-lg" aria-selected="false">large</option>
					</optgroup>
			</section>
			<a href="/<%= randUneditedChapter.book_id %>/<%= randUneditedChapter.chapter %>" id="rand-unedited-btn" class="cursor-hover-effect surface-pill surface-center surface-shadow-faint">random</a>
		</nav>
	</header>
	
	<main>
		<h1 class="chapter-title"><%= bookName %> <%= chapterID %></h1>
		<div id="verse-stats-container"><p id="verse-stats-clickme">&blacktriangledown; see verse stats &blacktriangledown;</p>
			<section id="verse-stats-detail" class="surface-card" hidden>
				<p id="percent-stat">progress: <span class="number"><%= chapterEditStats.percent_edited %>%</span></p>
			</section>
			
		</div>
		<% if (turnstileSiteKey) { %>
			<section id="turnstile-guard" class="surface-card">
				<p class="turnstile-copy">verify once before saving edits</p>
				<div id="turnstile-widget"></div>
			</section>
		<% } %>
		
		<p class="chapter-text">
			<% verses.forEach(v=> { %>
				<% if (v.paragraph === 1) { %></p><p class="chapter-text"><% } %>
				<sup class="verse-num"><%= v.verse %></sup>
				<span class="verse-text" <% if (v.is_edited === 1) { %>data-is-edited="true"<% } %> data-verse-id="<%= v.id %>" id="verse-<%= v.id %>"><%= v.text %></span>

			<% }) %>
		</p>
		<nav>
			<% if (prev) { %>
				<a href="/<%= prev.book_id %>/<%= prev.chapter %>">prev chapter</a>
			<% } %>
			<% if (next) { %>
				<a href="/<%= next.book_id %>/<%= next.chapter %>">next chapter</a>
			<% } %>
		</nav>
		<!-- forgot about entities lol https://stackoverflow.com/questions/14659240/angle-bracket-without-triggering-html-code -->
		<nav id="wing-nav">
			<a id="wing-nav-prev"
				<% if (prev) { %>
					href="/<%= prev.book_id %>/<%= prev.chapter %>"
				<% } else { %>
					href="#"
					class="disabled"
				<% } %>
			>
				<%- include('arrow-left') %>
			</a>
			<a id="wing-nav-next"
				<% if (next) { %>
					href="/<%= next.book_id %>/<%= next.chapter %>"
				<% } else { %>
					href="#"
					class="disabled"
				<% } %>
			>
				<%- include('arrow-left') %>
			</a>
		</nav>
	</main>
	
</body>

</html>