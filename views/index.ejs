 main bible view -->
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>The Bible - <%= bookName %>
			<%= chapterID %>
	</title>
	<link rel="stylesheet" href="/style.css">
	<script src="/main.js"></script>
</head>

<body data-book-id="<%= bookID %>" data-chapter-id="<%= chapterID %>">
	<main>
		<h2>
			<%= bookName %>
				<%= chapterID %>
		</h2>
		<nav>
			<select name="book" id="book-select">
				<% allBooks.forEach(book=> { %>
					<option value="<%= book.id %>" <% if (book.id===bookID) { %>
						selected
						<% } %>
							>
							<%= book.name %>
					</option>
					<% }) %>
			</select>
			<select name="chapter" id="chapter-select">
				<% for( let i=1; i <=numChapters; i++ ) { %>
					<option value="<%= i %>" <% if (i===chapterID) { %>
						selected
						<% } %>
							>
							<%= i %>
					</option>
					<% } %>
			</select>
		</nav>
		<p class="chapter-text">
			<% verses.forEach(v=> { %>
				<sup class="verse-num">
					<%= v.verse %>
				</sup>
				<span class="verse-text" data-verse-id="<%= v.id %>">
					<%= v.text %>
				</span>

				<% }) %>
		</p>
		<nav>
			<% if (prev) { %>
				<a href="/<%= prev.book_id %>/<%= prev.chapter %>">prev chapter</a>
				<% } %>
					<% if (next) { %>
						<a href="/<%= next.book_id %>/<%= next.chapter %>">next chapter</a>
						<% } %>
		</nav>
	</main>
	<!-- forgot about entities lol https://stackoverflow.com/questions/14659240/angle-bracket-without-triggering-html-code -->
	<nav id="wing-nav">
		<a id="wing-nav-prev" <% if (prev) { %>
			href="/<%= prev.book_id %>/<%= prev.chapter %>"
					<% } else { %>
						href="#"
						class="disabled"
						<% } %>
							>
							<p>&lt;</p>
		</a>
		<a id="wing-nav-next" <% if (next) { %>
			href="/<%= next.book_id %>/<%= next.chapter %>"
					<% } else { %>
						href="#"
						class="disabled"
						<% } %>
							>
							<p>&gt;</p>
		</a>
	</nav>
</body>

</html>