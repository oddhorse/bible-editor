<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>The Bible - <%= bookName %>
			<%= chapterID %>
	</title>
	<link rel="stylesheet" href="/style.css">
</head>

<body>

</body>

</html>
<h2>
	<%= bookName %>
		<%= chapterID %>
</h2>
<p>
	<% verses.forEach(v=> { %>
		<sup>
			<%= v.verse %>
		</sup>
		<%= v.text %>

			<% }) %>
</p>
<nav>
	<% if (prev) { %>
		<a href="/<%= prev.book_id %>/<%= prev.chapter %>">prev chapter</a>
		<% } %>
			<% if (next) { %>
				<a href="/<%= next.book_id %>/<%= next.chapter %>">next chapter</a>
				<% } %>
</nav>