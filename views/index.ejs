 main bible view -->
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>OpenBible - the people's bible</title>
	<link rel="stylesheet" href="/style.css">
	<link rel="stylesheet" href="/index.css">
</head>

<body>
	<header>
		<%- include('header', { currentPath }) %>
	</header>
	<main>
		<div class="hero">
			<p class="tagline">Together, we're writing the <span class="text-highlight">People's Open Bible</span>—the
				Bible anyone can edit, anonymously.</p>
			<div class="btn-set">
				<a href="" class="alt cursor-hover-effect">take a read</a>
				<a href="/<%= randUneditedChapter.book_id %>/<%= randUneditedChapter.chapter %>"
					class="main cursor-hover-effect">edit a page</a>
			</div>
		</div>
		<a href="/<%= votd.book_id %>/<%= votd.chapter %>#verse-<%= votd.id %>" id="votd">
			<p class="other">Verse of the day – <%= prettyDate %></p>
			<p class="quote">"<%= votd.text %>"</p>
			<p class="other">- <%= votdBookName %> <%= votd.chapter %>:<%= votd.verse %>, <i>People's Open Bible</i></p>
		</a>
		<p class="stat-line"><span class="wavy-text">Together</span>, we have written <i>25 verses</i> across <i>5 chapters</i> of <i>2 books</i> in the Bible.</p>
	</main>
</body>

</html>