 main bible view -->
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>OpenBible - the people's bible</title>
	<link rel="stylesheet" href="/style.css">
	<link rel="stylesheet" href="/index.css">
</head>

<body>
	<%- include('header.ejs') %>
	<main>
		<div class="hero">
			<p class="tagline">Together, we're writing the <span class="text-highlight">People's Open Bible</span>—the Bible anyone can edit, anonymously.</p>
			<div class="btn-set">
				<a href="" class="alt">take a read</a>
				<a href="" class="main">edit a page</a>
			</div>
		</div>
		<a href="/1/1" id="votd">
			<p class="other">Verse of the day – <%= prettyDate %></p>
			<p class="quote">"<%= votd.text %>"</p>
			<p class="other">- <%= votdBookName %> <%= votd.chapter %>:<%= votd.verse %>, People's Open Bible</p>
		</a>
		<p class="stat-line"><span class="wavy-text">Together</span>, we have written <i>25 verses</i> across <i>5 chapters</i> of <i>2 books</i> in the Bible.</p>
	</main>
</body>

</html>