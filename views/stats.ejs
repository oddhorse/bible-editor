 stats view -->
<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>OpenBible stats</title>
	<link rel="stylesheet" href="/style.css">
	<link rel="stylesheet" href="/stats.css">
</head>

<body>
	<header>
		<%- include('header', { currentPath }) %>
	</header>
	<main>

		<section id="book-blocks">
			<h2>BY THE BOOK</h2>
			<% for( let i = 0; i < allBookEditStats.length; i++ ) { %>
				<a href="/<%= allBookEditStats[i].book_id %>/1" class="stat-block" data-book-id="<%= allBookEditStats[i].book_id %>">
					<div>
						<p class="subhead">the book of</p>
						<h3><%= allBookEditStats[i].book_name %></h3>
						<p>is at <%= allBookEditStats[i].percent_edited %>%.</p>
						<p><%= allBookEditStats[i].edited_count %> of <%= allBookEditStats[i].total_count %> verses edited</p>
					</div>
					
				</a>
			<% } %>
		</section>
		<section id="recent-edits">
			<h2>RECENT EDITS</h2>
			<% for( let i = 0; i < recentEdits.length; i++ ) { %>
				<a href="/<%= recentEdits[i].book_id %>/<%= recentEdits[i].chapter %>#verse-<%= recentEdits[i].verse_id %>" class="recent-edit">
					<p class="title"><span class="which-verse"><%= recentEdits[i].book_name %> <%= recentEdits[i].chapter %>:<%= recentEdits[i].verse %></span> <span class="edit-date"><%= new Date(recentEdits[i].edited_at).toLocaleDateString() %> <%= new Date(recentEdits[i].edited_at).toLocaleTimeString() %></span></p>
					<p class="edit"><% recentEdits[i].diff.forEach(part => { %>
					<% if (part.added) { %>
					  	<span class="part-added"><%= part.value %></span>
					<% } else if (part.removed) {%>
						<span class="part-removed"><%= part.value %></span>
					<% } else { %>
						<span class="part-unchanged"><%= part.value %></span>
					<% } %>
					<% }) %></p>
					<!-- <p class="new-edit"><%= recentEdits[i].new_text %></p> -->
					<!-- <p class="old-edit"><%= recentEdits[i].old_text %></p> -->
				</a>
				
			<% } %>
		</section>
	</main>
</body>

</html>